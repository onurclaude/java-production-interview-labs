<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
        <relativePath/>
    </parent>

    <groupId>com.javalabs</groupId>
    <artifactId>pattern-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>03-pattern-service</name>
    <description>Design Patterns Production Lab - Checkout/Payment Processing Service</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!--
            Bilinçli olarak tek dependency: Web (Tomcat + Jackson). PostgreSQL, Kafka, Redis, JPA yok;
            bu lab'ın konusu design pattern'lerin gerçek backend problemlerini nasıl çözdüğüdür, altyapı değil.
            Test dependency'si de yok: doğrulama gerçek HTTP çağrılarıyla yapılır (01/02-service ile aynı kural).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>pattern-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
