<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
        <relativePath/>
    </parent>

    <groupId>com.javalabs</groupId>
    <artifactId>atomic-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>01-atomic-service</name>
    <description>Atomic Primitives Production Lab - external payment provider concurrency limit</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!--
            Bilinçli olarak tek dependency: Web (Tomcat + Jackson + RestClient).
            DB, Redis, Kafka, Actuator yok; bu lab yalnızca JVM içindeki concurrent state davranışını inceler.
            Test dependency'si de yok: proje kuralı gereği doğrulama gerçek HTTP çağrılarıyla yapılır.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>atomic-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
